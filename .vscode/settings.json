{
	"files.exclude": {
		"**/.astro": true,
		"**/.claude": true,
		"**/.vscode": true,
		"**/dist": true,
		"**/node_modules": true
	},

	"cSpell.language": "en-GB",
	"cSpell.languageSettings": [
		{
			"languageId": "*",
			"enabled": false
		},
		{
			"languageId": "markdown",
			"enabled": true
		},
		{
			"languageId": "mdx",
			"enabled": true
		}
	],

	"markdownlint.config": {
		"MD007": {
			"indent": 4
		}
	}
}
