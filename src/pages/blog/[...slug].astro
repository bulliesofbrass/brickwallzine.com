---
import { type CollectionEntry, render } from 'astro:content';

import { content              } from "#lib";
import { Image, Body, Article } from "#lib/elements";
import { Navigation           } from "#lib/components";

export const getStaticPaths = content.getStaticPaths("blog");

const post: CollectionEntry<'blog'> = Astro.props;

const { Content } = await render(post);
---

<Body title={post.data.title} description={post.data.description}>
	<header>
		<Navigation />
	</header>

	<main>
		<Article>
			{post.data.heroImage && <Image src={post.data.heroImage} alt="" />}
			<h1>{post.data.title}</h1>
			<Content />
		</Article>
	</main>
</Body>
