---
import { type CollectionEntry, render } from 'astro:content';

import { content                      } from "#lib";
import { Image, Body, Article, Footer } from "#lib/elements";
import { Navigation, Background       } from "#lib/components";

import { formatDate } from "#lib";

import { aura_png } from "#lib/assets";

export const getStaticPaths = content.getStaticPaths("blog");

const post: CollectionEntry<'blog'> = Astro.props;

const { Content } = await render(post);
---

<Body title={`${post.data.title} | BRICK WALL ZINE`} description={post.data.description}>
	<Background image={aura_png} repeat />

	<header>
		<Navigation />
	</header>

	<main>
		<Article>
			{post.data.heroImage && <Image src={post.data.heroImage} alt="" style={{ aspectRatio: "16 / 9", objectFit: "cover" }} priority />}
			<h2 class="date">{formatDate(post.data.datePublished)}</h2>
			<h1>{post.data.title}</h1>
			<h2 class="date">{post.data.authors}</h2>
			<Content />
		</Article>
	</main>

	<Footer />
</Body>

<style>
	h1 {
		font-family: var(--font-afacad);
		text-align: center;
	}

	h2 {
		font-size: 20px;
		text-align: center;
	}
</style>
