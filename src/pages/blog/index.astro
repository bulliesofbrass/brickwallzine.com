---
import { getCollection } from 'astro:content';

import { formatDate } from "#lib";
import { Body } from "#lib/elements";
import { Navigation, Background, BlogPostCard } from "#lib/components";

import { aura } from "#lib/assets";

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf(),
);

const SITE_TITLE = "BLOG | BRICK WALL MAGAZINE";
const SITE_DESCRIPTION = "";

const [featured, ...rest] = posts;
const secondary = rest.slice(0, 4);
const remaining = posts;
---

<Body title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<Background image={aura} repeat />

	<header>
		<Navigation />
	</header>

	<main>
		<div class="layout">
			<div class="one">
				<a class="featured" href={`/blog/${featured.id}/`}>
					<div class="hero image">
						<div class="iimage">
							<img src={featured.data.heroImage.src} alt="" />
						</div>
					</div>

					<div class="text">
						<div class="date">{formatDate(featured.data.datePublished)}</div>
						<h2 class="title">{featured.data.title}</h2>
					</div>
				</a>
			</div>

			<div class="two">
				{secondary.map((post) => (
					<div class="card">
						<a href={`/blog/${post.id}`}>
							<div class="image">
								<img src={post.data.heroImage.src} />
							</div>

							<div class="text">
								<span class="date">{formatDate(post.data.datePublished)}</span>
								<h2 class="title">{post.data.title}</h2>
								<span class="categories">{post.data.category}</span>
							</div>
						</a>
					</div>
				))}
			</div>
		</div>

		<div class="three">
			{remaining.map((post) => (
				<BlogPostCard
					slug={post.id}
					title={post.data.title}
					date={post.data.datePublished}
					category={post.data.category}
					hero={post.data.heroImage}
				/>
			))}
		</div>
	</main>
</Body>

<style>
	:root {
		--header-height: 128px;
	}

	main {
		max-width: 1500px;
		margin: auto;
	}

	img {
		display: block;
		width: 100%;
		object-fit: cover;
	}

	.layout {
		--blog-gap: 1rem;

		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: var(--blog-gap);
		padding: 0.5rem 0.5rem 0.5rem 0rem;
		box-sizing: border-box;
	}

	.one {
		position: relative;

		img {
			position: absolute;
			inset: 0;
			height: 100%;
			width: 100%;
			object-fit: cover;
		}

		.image {
			padding: 10px;
			box-sizing: border-box;
			border: 1px solid black;
		}

		.iimage {
			position: absolute;
			inset: 0;
			height: 100%;

			padding: 10px;
			box-sizing: border-box;
		}

		.text {
			position: absolute;
			left: 0;
			bottom: 2rem;
			padding: 0.5rem 2.5rem;
			background: white;

			/* background-color: rgba(from #F89589 r g b / 1); */
			background: rgba(from #3D3937 r g b / 0.5);

			/* border: 1px solid black; */

			.title {
				font-size: 2rem;
			}

			.title,
			.date {
				color: white;
			}


		}
	}

	.two {
		display: grid;
		gap: var(--blog-gap);

		.card {
			/* background-color: rgba(from #F89589 r g b / 0.5); */

			a {
				display: grid;
				grid-template-columns: 1fr 2fr;
				/* gap: var(--blog-gap); */
				gap: 5px;
				/* border: 1px solid black; */
				/* padding: 3px; */
				box-sizing: border-box;

				/* justify-content: start; */
				/* background: white; */
				/* border: 1px black solid; */
			}

			.image,
			.text {
				border: 1px solid black;
				padding: 3px;
				box-sizing: border-box;
				background-color: rgba(from #F89589 r g b / 0.5);
			}

			.text {
				display: flex;
				flex-direction: column;
				justify-content: center;
				gap: 0.25rem;
				padding-left: 0.5rem;
			}

			img {
				aspect-ratio: 4 / 3;
			}

			h2 {
				font-size: 1.25rem;
				line-height: 1.5rem;
			}
		}

		.date,
		.categories {
			text-transform: uppercase;
			font-size: 1rem;
		}
	}


	.three {
		--gap: 0.5rem;

		display: flex;
		flex-wrap: wrap;
		gap: var(--gap);
		padding: var(--gap);
		box-sizing: border-box;

		> :global(.card) {
			flex: 1 1 max(28rem, calc(50% - var(--gap) / 2));
		}
	}
</style>










