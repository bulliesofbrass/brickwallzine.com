---
import { Body } from "#lib/elements";
import { BlogPostCard } from "#lib/components";
import { getArticles } from "#lib/articles";

import "#lib/articles/blog.css";

const articles = getArticles();
---

<Body title="Blog | BRICK WALL MAGAZINE" description="">
