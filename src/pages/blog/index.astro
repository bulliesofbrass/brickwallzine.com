---
import { getCollection } from 'astro:content';

import { formatDate } from "#lib";
import { Body } from "#lib/elements";
import { Navigation, Background, BlogPostCard } from "#lib/components";
import { IMG_0751 } from "#lib/assets/index";

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf(),
);

const SITE_TITLE = "BLOG | BRICK WALL MAGAZINE";
const SITE_DESCRIPTION = "";

const [featured, ...rest] = posts;
const secondary = rest.slice(0, 4);
const remaining = posts;
---

<Body title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<header>
		<Background image={IMG_0751} />
		<Navigation />
	</header>

	<main>
		<div class="layout">
			<div class="one">
				<a class="featured" href={`/blog/${featured.id}/`}>
					<div class="hero">
						<img src={featured.data.heroImage.src} alt="" />
					</div>

					<div class="text">
						<div>{formatDate(featured.data.datePublished)}</div>
						<h2 class="title">{featured.data.title}</h2>
					</div>
				</a>
			</div>

			<div class="two">
				{secondary.map((post) => (
					<div class="card">
						<a href={`/blog/${post.id}`}>
							<img src={post.data.heroImage.src} />
							<div>
								<span>{formatDate(post.data.datePublished)}</span>
								{/* <span>{post.data.category}</span> */}
								<h2>{post.data.title}</h2>
							</div>
						</a>
					</div>
				))}
			</div>
		</div>

		<div class="three">
			{remaining.map((post) => (
				<BlogPostCard
					slug={post.id}
					title={post.data.title}
					date={post.data.datePublished}
					category={post.data.category}
					hero={post.data.heroImage}
				/>
			))}
		</div>
	</main>
</Body>

<style>
	:root {
		--header-height: 128px;
	}

	img {
		display: block;
		width: 100%;
		object-fit: cover;
	}

	.layout {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 1rem;
		padding: 0 1rem 1rem 0;
		box-sizing: border-box;
	}

	.one {
		position: relative;

		img {
			position: absolute;
			inset: 0;
			height: 100%;
		}

		.text {
			position: absolute;
			left: 0;
			bottom: 2rem;
			padding: 1rem 2.5rem;
			background: #fff;
		}
	}

	.two {
		display: grid;
		gap: 1rem;

		.card {
			a {
				display: grid;
				grid-template-columns: 1fr 2fr;
				gap: 0.75rem;
				background-color: white;
			}

			> a > div {
				display: flex;
				flex-direction: column;
				justify-content: center;
				gap: 0.25rem;
			}

			img {
				aspect-ratio: 4 / 3;
			}

			h2 {
				font-size: 1.25rem;
				line-height: 1.5rem;
			}
		}
	}


	.three {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 0.5rem;
		box-sizing: border-box;
	}
</style>










