---
import { getCollection } from 'astro:content';

import { formatDate } from "#lib";
import { Body } from "#lib/elements";
import { Navigation, Background, BlogPostCard } from "#lib/components";

import { aura_png } from "#lib/assets";

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf(),
);

const SITE_TITLE = "BLOG | BRICK WALL ZINE";
const SITE_DESCRIPTION = "";

const [featured, ...rest] = posts;
const secondary = rest.slice(0, 4);
---

<Body title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<Background image={aura_png} repeat />

	<header>
		<Navigation />
	</header>

	<main>
		<div class="layout">
			<div class="one">
				<a class="featured" href={`/blog/${featured.id}/`}>
					<div class="hero image">
						<div class="iimage">
							<img src={featured.data.heroImage.src} alt="" />
						</div>
					</div>

					<div class="text">
						<!-- <div class="date">{formatDate(featured.data.datePublished)}</div> -->
						<h2 class="title">{featured.data.title}</h2>
					</div>
				</a>
			</div>

			<div class="two">
				{secondary.map((post) => (
					<div class="card">
						<a href={`/blog/${post.id}`}>
							<div class="image">
								<img src={post.data.heroImage.src} />
							</div>

							<div class="text">
								<span class="date">{formatDate(post.data.datePublished)}</span>
								<h2 class="title">{post.data.title}</h2>
								<span class="categories">{post.data.category}</span>
							</div>
						</a>
					</div>
				))}
			</div>
		</div>

		<div class="three">
			{posts.map((post) => (
				<BlogPostCard
					slug={post.id}
					title={post.data.title}
					date={post.data.datePublished}
					category={post.data.category}
					hero={post.data.heroImage}
				/>
			))}
		</div>
	</main>
</Body>

<style>
	:root {
		--header-height: 128px;
		--ink: #1A0A08;
		--cream: #FFF1E0;
		--coral: #FFB38A;
	}

	main {
		max-width: 1500px;
		margin: auto;
	}

	img {
		display: block;
		height: 100%;
		width: 100%;
		object-fit: cover;
	}

	.layout {
		--blog-gap: 1rem;

		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: var(--blog-gap);
		padding: 0.5rem 0.5rem 0.5rem 0rem;
		box-sizing: border-box;
	}

	.one {
		position: relative;

		img {
			position: absolute;
			inset: 0;
			height: 100%;
			width: 100%;
			object-fit: cover;
		}

		.image {
			padding: 10px;
			box-sizing: border-box;
			border: 1px solid black;
		}

		.iimage {
			position: absolute;
			inset: 0;
			height: 100%;

			padding: 10px;
			box-sizing: border-box;
		}

		.text {
			position: absolute;
			inset: auto 0 0 0;
			padding: 6rem 2.5rem 2.5rem;
			background: linear-gradient(to top, rgba(from var(--ink) r g b / 0.85), rgba(from var(--ink) r g b / 0));
			color: var(--cream);

			.title {
				font-size: 2rem;
				color: var(--cream);
			}

			.date {
				color: var(--coral);
				text-transform: uppercase;
				letter-spacing: 0.08em;
			}
		}
	}

	.two {
		display: grid;
		gap: var(--blog-gap);

		.card {
			/* background-color: rgba(from #F89589 r g b / 0.5); */

			a {
				display: grid;
				grid-template-columns: 1fr 2fr;
				/* gap: var(--blog-gap); */
				gap: 5px;
				/* border: 1px solid black; */
				/* padding: 3px; */
				box-sizing: border-box;

				/* justify-content: start; */
				/* background: white; */
				/* border: 1px black solid; */
			}

			.image,
			.text {
				border: 1px solid black;
				padding: 3px;
				box-sizing: border-box;
				background-color: rgba(from #F89589 r g b / 0.5);
			}

			.text {
				display: flex;
				flex-direction: column;
				justify-content: center;
				gap: 0.25rem;
				padding-left: 0.5rem;
			}

			img {
				aspect-ratio: 4 / 3;
			}

			h2 {
				font-size: 1.25rem;
				line-height: 1.5rem;
			}
		}

		.date,
		.categories {
			text-transform: uppercase;
			font-size: 1rem;
		}
	}

	.three {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
		row-gap: 3rem;
		/* column-gap: 2rem; */

		padding: 0.5rem 0.5rem 3rem;
		box-sizing: border-box;

		:global(img) {
			display: block;
			width: 100%;
			max-width: 100%;
			height: auto;
			aspect-ratio: 4 / 3;
			object-fit: cover;
		}
	}

	@media (width < 900px) {
		.layout {
			display: none;
		}

		.three {
			grid-template-columns: 1fr;
			padding: 1rem 1rem 3rem;
		}
	}

	@media (width >= 900px) {
		.three > :global(:nth-child(-n + 5)) {
			display: none;
		}
	}
</style>
