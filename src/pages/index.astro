---
import { Body, Image } from "#lib/elements";
import { Polaroids, Navigation, IMG_0751 } from "#lib/assets/index";

const SITE_TITLE = "BRICK WALL MAGAZINE";
const SITE_DESCRIPTION = "";
---

<Body title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<header>
		<Image class="welcome-desktop" src={IMG_0751} />
		<Navigation />
	</header>

	<main>
		<Polaroids />
	</main>
</Body>

<style>
	header {
		position: relative;
		height: 100svh;
		width: 100%;
	}

	.welcome-desktop {
		position: absolute;
		object-fit: cover;
		z-index: 1;
	}

	main {
		position: relative;
		height: 100svh;
	}
</style>
