---
import { Body } from "#lib/elements";
import { Background } from "#lib/components";
import { Bag, IMG_0751 } from "#lib/assets/index";

const SITE_TITLE = "BRICK WALL ZINE";
const SITE_DESCRIPTION = "";
---

<Body title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<header>
		<Background image={IMG_0751} />
		<nav>
			<Bag open={["left"]}>
				<div slot="left" class="links">
					<a href="/blog/">blog</a>
					<a href="/about/">about</a>
					<a href="/contact/">contact</a>
				</div>
				<div slot="right" class="links">
					<a href="https://www.instagram.com/brickwallzine/">Instagram</a>
					<a href="https://substack.com/@brickwallzine">Substack</a>
				</div>
			</Bag>
		</nav>
	</header>

	<main>

	</main>
</Body>

<style>
	header {
		position: relative;
		height: 100svh;
		display: flex;
		justify-content: center;
	}

	.links {
		display: flex;
		gap: 3rem;
		padding: 3rem;
		box-sizing: border-box;
	}

	nav {
		width: 100%;
		font-family: var(--font-blackout-two-am);
		font-size: 42px;
		gap: 3rem;
		padding: 3rem;
		box-sizing: border-box;
	}

	a {
		line-height: 1;
		text-box: trim-both cap alphabetic;
	}

	@media (width >= 850px) {
		nav {
			display: flex;
			justify-content: center;
			align-items: center;
		}
	}

	@media (width < 850px) {
		nav {
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
		}

		.links {
			flex-direction: column;
			align-items: center;
		}
	}
</style>
