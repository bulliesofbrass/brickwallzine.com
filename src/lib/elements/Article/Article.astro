---
import { Section } from "#lib/elements";
---

<Section style="padding-top: 0" maxWidth="700px">
	<article>
		<slot />
	</article>
</Section>

<style is:global>
	article {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		padding-top: 1rem;
	}

	article blockquote p {
		font-size: 1.25rem;
		line-height: 1.5rem;
		font-family: sans;
		font-style: italic;
	}

	article a {
		text-decoration: underline !important;
	}

	h1, h2, h3, h4, h5, h6 {
		font-weight: normal;
	}

	article p {
		margin: 0;
	}

	article a {
		/* color: var(--color-orange); */
		text-decoration: none;
	}

	article a:hover {
		text-decoration: underline;
	}

	article > p,
	article > ul > li,
	article > ol > li {
		font-size: 1.25rem;
		line-height: 1.5rem;
		margin: 0;
	}

	article > p > img {
		height: auto;
		width: 100%;
	}

	article > ol,
	article > ul {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
</style>
