---
import { Picture } from 'astro:assets';

interface Props {
	class?: string;
	style?: astroHTML.JSX.HTMLAttributes['style'];
	alt?: string;
	src: ImageMetadata;
	width?: number;
	sizes?: string;
	priority?: boolean;
}

const {
	class: className,
	style,
	alt = "",
	src,
	width = 700,
	sizes,
	priority = false,
	...rest
} = Astro.props;
---

<Picture
	class:list={["picture", className]}
	style={style}
	alt={alt}
	src={src}
	width={Math.min(width, src.width)}
	sizes={sizes}
	priority={priority}
	layout="constrained"
	formats={["webp"]}
	{...rest}
/>

<style>
	.picture {
		height: 100%;
		width: 100%;
	}
</style>
