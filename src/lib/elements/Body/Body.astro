---
import type { ImageMetadata } from 'astro';

import { HTML, Head } from "#lib/elements";

import IMG_0751 from "./IMG_0751.jpeg";

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const {
	title,
	description,
	image = IMG_0751
} = Astro.props;
---

<HTML>
    <Head title={title} description={description} image={image} />

    <body>
		<slot />
    </body>
</HTML>
