---
import { Logo } from "#lib/components";

import bag from "./bag.png";

const isHome = Astro.url.pathname === "/";
---

<nav>
	<div class="left">
		<button id="bag" type="button" aria-label="Open menu">
			<img src={bag.src} width={bag.width} height={bag.height} alt="" />
		</button>
	</div>

	<div class="center">
		<Logo />
	</div>
</nav>

<style>
	nav {
		width: 100%;
		gap: 1rem;
		padding: 3rem;
		box-sizing: border-box;
	}

	@media (width >= 960px) {
		nav {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
		}
	}

	@media (width < 960px) {
		nav {
			display: flex;
			align-items: center;
			justify-content: center;
			text-align: center;
		}

		.left {
			display: none;
		}
	}

	#bag {
		position: relative;
		align-self: stretch;
		justify-self: start;
		aspect-ratio: 2767 / 1838;
		padding: 0;
		border: none;
		background-color: transparent;
		cursor: pointer;
		filter:
			drop-shadow(2px 0 0 black)
			drop-shadow(-2px 0 0 black)
			drop-shadow(0 2px 0 black)
			drop-shadow(0 -2px 0 black);
	}

	#bag > img {
		height: 75px;
		width: auto;
	}

</style>
