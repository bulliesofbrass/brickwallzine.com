---
import bag from "./bag.png";
import glasses from "./glasses.png";
import logo from "./logo.svg";
---

<nav
	style={`--bag-half: ${(37.5 * bag.width) / bag.height}px; --glasses-half: ${(72.5 * glasses.width) / glasses.height}px`}
>
	<div class="slot">
		<div>
			<a class="logo" href="/">
				<span>brick wall</span>
				<img alt="brick wall" src={logo.src} />
			</a>
		</div>
	</div>
	<button type="button" aria-label="Toggle menu" aria-expanded="false">
		<picture>
			<source media="(width < 900px)" srcset={glasses.src} />
			<img alt="" src={bag.src} />
		</picture>
	</button>
	<div class="slot links">
		<div>
			<a href="/blog/">blog</a>
			<a href="/about/">about</a>
			<a href="mailto:brickwallmagazine.admin@gmail.com">contact</a>
		</div>
	</div>
</nav>

<script>
	const button = document.querySelector<HTMLButtonElement>("nav button")!;
	button.addEventListener("click", () => {
		button.ariaExpanded = `${button.ariaExpanded !== "true"}`;
	});

	document.querySelector("nav .logo")!.addEventListener("click", (event) => {
		if (matchMedia("(width < 900px)").matches) {
			event.preventDefault();
			button.click();
		}
	});
</script>

<style>
	nav {
		--half: var(--bag-half);
		display: flex;
		justify-content: center;
		align-items: center;
		padding: 3rem;
		box-sizing: border-box;
	}

	.slot {
		display: grid;
		grid-template-columns: 1fr;
		overflow-x: clip;
		transition:
			grid-template-columns 0.25s ease-in-out,
			visibility 0.25s;
	}

	.slot > div {
		min-width: 0;
		white-space: nowrap;
	}

	.slot.links {
		justify-content: end;
	}

	.links > div {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		gap: 2rem;
	}

	.slot.links,
	nav:has([aria-expanded="true"]) .slot {
		grid-template-columns: 0fr;
		visibility: hidden;
	}

	nav:has([aria-expanded="true"]) .links {
		grid-template-columns: 1fr;
		visibility: visible;
	}

	button {
		position: relative;
		z-index: 1;
		margin-inline: calc(var(--half) * -1) 0;
		display: flex;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
		transition: margin 0.5s ease-in-out;
	}

	nav:has([aria-expanded="true"]) button {
		margin-inline: 0 calc(var(--half) * -1);
	}

	img {
		display: block;
		height: 75px;
		width: auto;
		will-change: transform;
		transition: scale 0.2s;
		filter:
			drop-shadow(2px 0 0 black)
			drop-shadow(-2px 0 0 black)
			drop-shadow(0 2px 0 black)
			drop-shadow(0 -2px 0 black);
	}

	button:hover img {
		scale: 1.15;
	}

	a {
		font-family: var(--font-blackout-two-am);
		font-size: 42px;
		line-height: 1;
		text-box: trim-both cap alphabetic;
	}

	.links a:first-child {
		margin-left: calc(var(--half) + 1rem);
	}

	.logo {
		--font-size: 64px;
		display: block;
		font-family: var(--font-oi);
		font-size: var(--font-size);
		line-height: var(--font-size);
		text-box: trim-both cap alphabetic;
		width: fit-content;
		margin-right: calc(var(--half) + 1rem);
		overflow: clip;
		overflow-clip-margin: 0.05em;
		text-transform: uppercase;
		color: black;
		text-decoration: none;
	}

	.logo img {
		display: none;
		height: 100px;
		filter: none;
	}

	@media (width < 900px) {
		nav {
			--half: var(--glasses-half);
			padding-bottom: 1rem;
		}

		.links > div {
			display: grid;
			justify-items: start;
			gap: 1rem;
		}

		.links a {
			position: relative;
			margin-left: calc(var(--half) + 1rem);
			pointer-events: none;
		}

		.links a::after {
			content: "";
			position: absolute;
			inset: 0;
			pointer-events: auto;
		}

		img {
			height: 145px;
		}

		.logo span {
			display: none;
		}

		.logo img {
			display: block;
		}
	}

	@media (width < 600px) {
		nav {
			padding-inline: 1rem;
		}
	}
</style>
