---
import { Logo } from "#lib/components";

import bag from "./bag.png";

const isHome = Astro.url.pathname === "/";
---

<nav>

	{!isHome && (
		<button
			id="bag"
			type="button"
			aria-label="Open menu"
		>
			<img src={bag.src} width={bag.width} height={bag.height} alt="" />
		</button>
	)}

	<div class="center">
		{!isHome && (
			<Logo />
		)}

		{isHome && (
			<div class="links">
				<a href="/blog/">blog</a>
				<a href="/about/">about</a>
				<a href="/contact/">contact</a>
			</div>
		)}
	</div>
</nav>

<style>
	nav {
		--gap: 1rem;

		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: var(--var);
		padding: 3rem;
		box-sizing: border-box;
	}

	#bag {
		position: relative;
		align-self: stretch;
		justify-self: start;
		aspect-ratio: 2767 / 1838;
		padding: 0;
		border: none;
		background-color: transparent;
		cursor: pointer;
		transition: transform 0.15s ease;
		filter:
			drop-shadow(2px 0 0 black)
			drop-shadow(-2px 0 0 black)
			drop-shadow(0 2px 0 black)
			drop-shadow(0 -2px 0 black);

		&:hover {
			transform: scale(1.05);
		}

		img {
			position: absolute;
			inset: 0;
			height: 100%;
			width: 100%;
			object-fit: contain;
		}
	}

	.center {
		grid-column: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--gap);
	}

	.links {
		display: flex;
		font-family: var(--font-blackout-two-am);
		font-weight: bold;
		font-size: 42px;
		gap: calc(var(--gap) * 2);
	}
</style>
