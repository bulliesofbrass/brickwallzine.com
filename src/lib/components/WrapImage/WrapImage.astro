---
import type { ImageMetadata } from "astro";

import { Image } from "#lib/elements";

interface Props {
	src: ImageMetadata;
	width?: number;
	height?: string;
	alt?: string;
}

const { src, width, height, alt = "" } = Astro.props;

const style = [
	`--ratio: ${src.width} / ${src.height}`,
	width !== undefined && `--width: ${width}px`,
	height !== undefined && `--height: ${height}`
].filter(Boolean).join("; ");
---

<wrap-image class:list={{ centred: height !== undefined }} style={style}>
	<div class="subject">
		<Image src={src} alt={alt} />
	</div>
</wrap-image>

<style>
	wrap-image {
		display: block;
		position: relative;
	}

	.subject {
		width: 100%;
		aspect-ratio: var(--ratio);
	}

	@media (width >= 700px) {
		wrap-image {
			height: 0;
		}

		.subject {
			position: absolute;
			top: 0;
			left: 50%;
			translate: -50% 0;
			width: var(--width, auto);
			height: var(--height, auto);
		}

		wrap-image.centred {
			position: static;
		}

		.centred .subject {
			top: 50%;
			translate: -50% -50%;
		}

		:global(*:has(> wrap-image.centred)) {
			position: relative;
		}
	}

	:global(p > .wrap-line) {
		display: block;
		position: relative;
	}

	:global(p > .wrap-line > span) {
		position: absolute;
		top: 0;
		white-space: pre;
	}
</style>

<script>
	import {
		layoutNextLineRange,
		materializeLineRange,
		prepareWithSegments,
		type LayoutCursor,
		type PreparedTextWithSegments
	} from "@chenglou/pretext";

	const WHITE = 235;
	const OPAQUE = 128;
	const MARGIN = 16;
	const MIN_WIDTH = 60;

	const desktop = window.matchMedia("(width >= 700px)");

	interface Paragraph {
		element: HTMLParagraphElement;
		text: string;
		prepared: PreparedTextWithSegments;
	}

	interface Edges {
		left: number;
		right: number;
	}

	interface Slot {
		x: number;
		width: number;
	}

	class WrapImage extends HTMLElement {
		source = new Image();
		subject!: HTMLElement;
		edges: Edges[] = [];
		paragraphs: Paragraph[] = [];
		lineHeight = 0;
		subjectWidth = 0;

		async connectedCallback() {
			const img = this.querySelector("img")!;
			this.subject = this.querySelector(".subject")!;
			this.source.src = img.currentSrc || img.src;
			await this.source.decode();

			const paragraphs = [...this.parentElement!.children]
				.filter((i): i is HTMLParagraphElement => i instanceof HTMLParagraphElement);

			if (paragraphs.length === 0) return;

			const style = getComputedStyle(paragraphs[0]);
			const font = `${style.fontStyle} ${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
			await document.fonts.load(font);

			this.lineHeight = parseFloat(style.lineHeight);

			this.paragraphs = paragraphs.map(element => {
				const text = element.textContent ?? "";
				return { element, text, prepared: prepareWithSegments(text, font) };
			});

			new ResizeObserver(() => this.layout()).observe(this);
			window.addEventListener("resize", () => this.layout());
			desktop.addEventListener("change", () => this.layout());
		}

		scan(width: number) {
			const height = Math.round(width * this.source.naturalHeight / this.source.naturalWidth);

			const canvas = document.createElement("canvas");
			canvas.width = width;
			canvas.height = height;

			const context = canvas.getContext("2d")!;
			context.drawImage(this.source, 0, 0, width, height);
			const { data } = context.getImageData(0, 0, width, height);

			this.edges = [];
			this.subjectWidth = width;

			for (let y = 0; y < height; y++) {
				let left = width;
				let right = 0;

				for (let x = 0; x < width; x++) {
					const i = (y * width + x) * 4;

					const opaque = data[i + 3] >= OPAQUE;
					const white = data[i] >= WHITE && data[i + 1] >= WHITE && data[i + 2] >= WHITE;

					if (opaque && !white) {
						left = Math.min(left, x);
						right = x + 1;
					}
				}

				this.edges.push({ left, right });
			}
		}

		edgesBetween(top: number, bottom: number): Edges {
			let left = this.subjectWidth;
			let right = 0;

			for (let y = Math.max(0, Math.floor(top)); y < Math.min(this.edges.length, Math.ceil(bottom)); y++) {
				left = Math.min(left, this.edges[y].left);
				right = Math.max(right, this.edges[y].right);
			}

			return { left, right };
		}

		slots(top: number, subject: DOMRect, box: DOMRect): Slot[] {
			const { left, right } = this.edgesBetween(top, top + this.lineHeight);

			if (left >= right) return [{ x: 0, width: box.width }];

			const slots: Slot[] = [];

			const leftWidth = subject.left + left - MARGIN - box.left;
			if (leftWidth >= MIN_WIDTH) slots.push({ x: 0, width: leftWidth });

			const rightX = subject.left + right + MARGIN - box.left;
			if (box.width - rightX >= MIN_WIDTH) slots.push({ x: rightX, width: box.width - rightX });

			return slots;
		}

		layout() {
			if (this.paragraphs.length === 0) return;

			const last = this.paragraphs[this.paragraphs.length - 1].element;

			if (!desktop.matches) {
				this.style.marginBottom = "";
				last.style.marginBottom = "";

				for (const { element, text } of this.paragraphs) {
					element.textContent = text;
				}

				return;
			}

			const gap = parseFloat(getComputedStyle(this.parentElement!).rowGap) || 0;
			this.style.marginBottom = `${-gap}px`;
			last.style.marginBottom = "";

			const width = Math.round(this.subject.getBoundingClientRect().width);
			if (width !== this.subjectWidth) this.scan(width);

			for (const { element, prepared } of this.paragraphs) {
				const subject = this.subject.getBoundingClientRect();
				const box = element.getBoundingClientRect();
				const lines: HTMLSpanElement[] = [];
				let cursor: LayoutCursor | undefined;
				let y = box.top - subject.top;
				let done = false;

				while (!done) {
					const line = document.createElement("span");
					line.className = "wrap-line";
					line.style.height = `${this.lineHeight}px`;

					for (const slot of this.slots(y, subject, box)) {
						const range = layoutNextLineRange(prepared, slot.width, cursor);

						if (range === null) {
							done = true;
							break;
						}

						const fragment = document.createElement("span");
						fragment.style.left = `${slot.x}px`;
						fragment.textContent = materializeLineRange(prepared, range).text;
						line.append(fragment);

						cursor = range.end;
					}

					if (line.childElementCount > 0 || !done) lines.push(line);
					y += this.lineHeight;
				}

				element.replaceChildren(...lines);
			}

			const overflow = this.subject.getBoundingClientRect().bottom - last.getBoundingClientRect().bottom;
			if (overflow > 0) last.style.marginBottom = `${overflow}px`;
		}
	}

	customElements.define("wrap-image", WrapImage);
</script>
