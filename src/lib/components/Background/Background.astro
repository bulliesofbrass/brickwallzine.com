---
import { Image } from "#lib/elements";

interface Props {
	image: ImageMetadata;
	repeat?: boolean;
	opacity?: number;
}

const { image, repeat = false, opacity } = Astro.props;
---

<div
	class:list={["background", { repeat }]}
	style={{
		opacity,
		"--image": repeat ? `url("${image.src}")` : undefined,
		"--ratio": repeat ? image.height / image.width : undefined,
	}}
	aria-hidden="true"
>
	{!repeat && <Image src={image} />}
</div>

<style>
	.background {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;

		:global(img) {
			display: block;
			height: 100%;
			width: 100%;
			object-fit: cover;
		}
	}

	.repeat {
		container-type: inline-size;
		background: var(--image) top / 100% auto repeat-y;

		&::after {
			--tile: calc(100cqw * var(--ratio));

			content: "";
			position: absolute;
			inset: 0;
			background: var(--image) bottom / 100% auto repeat-y;
			transform: scaleY(-1);
			mask-image: repeating-linear-gradient(
				to top,
				transparent 0 var(--tile),
				black var(--tile) calc(var(--tile) * 2)
			);
		}
	}

	:global(body:has(> .background.repeat)) {
		position: relative;
		min-height: 100dvh;
	}
</style>
