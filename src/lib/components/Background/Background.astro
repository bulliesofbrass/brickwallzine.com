---
import { Image } from "#lib/elements";

interface Props {
	image: ImageMetadata;
	repeat?: boolean;
	opacity?: number;
	tiles?: number;
}

const { image, repeat = false, opacity, tiles = 10 } = Astro.props;
---

<div
	class:list={["background", { repeat }]}
	style={opacity !== undefined ? `opacity: ${opacity}` : undefined}
	aria-hidden="true"
>
	{repeat
		? Array.from({ length: tiles }, (_, i) => <Image src={image} class={i % 2 ? "flipped" : undefined} />)
		: <Image src={image} />}
</div>

<style>
	.background {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;

		:global(img) {
			display: block;
			height: 100%;
			width: 100%;
			object-fit: cover;
		}
	}

	.repeat {
		overflow: hidden;

		:global(img) {
			height: auto;
		}

		:global(.flipped) {
			transform: scaleY(-1);
		}
	}

	:global(body:has(> .background.repeat)) {
		position: relative;
		min-height: 100dvh;
	}
</style>
