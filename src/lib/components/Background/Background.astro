---
import { Image } from "#lib/elements";

interface Props {
	image: ImageMetadata;
	repeat?: boolean;
	opacity?: number;
}

const { image, repeat = false, opacity } = Astro.props;
const ratio = image.height / image.width;
---

<div
	class:list={["background", { repeat }]}
	style={{ opacity, "--ratio": ratio }}
	data-ratio={ratio}
	aria-hidden="true"
>
	<Image src={image} />
	{repeat && <Image src={image} class="flipped" />}
</div>

<script>
	for (const background of document.querySelectorAll<HTMLElement>(".background.repeat")) {
		const pair = [...background.children];
		const ratio = Number(background.dataset.ratio);

		new ResizeObserver(() => {
			const tile = Math.max(1, Math.round(background.offsetWidth * ratio));
			const tiles = Math.ceil(background.offsetHeight / tile);

			while (background.children.length < tiles) {
				background.append(...pair.map((node) => node.cloneNode(true)));
			}
		}).observe(background);
	}
</script>

<style>
	.background {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;

		:global(img) {
			display: block;
			height: 100%;
			width: 100%;
			object-fit: cover;
		}
	}

	.repeat {
		container-type: inline-size;
		overflow: hidden;

		:global(img) {
			height: round(100cqw * var(--ratio), 1px);
		}

		:global(.flipped) {
			transform: scaleY(-1);
		}
	}

	:global(body:has(> .background.repeat)) {
		position: relative;
		min-height: 100dvh;
	}
</style>
