---
import { Image } from "#lib/elements";

interface Props {
	image: ImageMetadata;
}

const { image } = Astro.props;
---

<div class="background" aria-hidden="true">
	<Image src={image} />
</div>

<style>
	.background {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;

		:global(img) {
			display: block;
			height: 100%;
			width: 100%;
			object-fit: cover;
		}
	}
</style>
