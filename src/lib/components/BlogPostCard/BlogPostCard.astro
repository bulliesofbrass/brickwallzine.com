---
import { formatDate } from "#lib";
import { Image } from "#lib/elements";

interface Props {
	slug: string;
	title: string;
	date: Date;
	category: string;
	hero: ImageMetadata;
}

const { slug, title, date, category, hero} = Astro.props;
---

<a class="card" href={`/blog/${slug}/`}>
	<div class="image">
		<Image src={hero} width={400} />
	</div>

	<div class="text">
		<div class="date">{formatDate(date)}</div>
		<div class="title">{title}</div>
	</div>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.date {
		text-align: center;
		font-size: 1rem;
	}

	.title {
		font-size: 1.25rem;
		text-align: center;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		overflow: hidden;
	}
</style>
