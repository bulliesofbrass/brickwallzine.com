---
import type { Article } from "#lib/articles";

import { Image } from "#lib/elements";
import { formatDate } from "#lib/utils";

interface Props {
	article: Article;
}

const { article } = Astro.props;
---

<a class="card" href={article.href}>
	<div class="image">
		{article.image && <Image class="thumbnail" src={article.image} />}
	</div>

	<div class="text">
		<div class="date">{formatDate(article.date.published)}</div>

		<div class="title">{article.title}</div>

		<div class="author">{article.author}</div>
	</div>
</a>

<style>
	.card {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
		gap: 0.5rem;
		box-sizing: border-box;
	}

	.thumbnail {
		height: 100%;
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	@media(width < 700px) {
		.card {
			display: flex;
			flex-direction: column;
			padding: 0;
		}

		.image {
			aspect-ratio: 4 / 3;
		}
	}

	.text {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.5rem;
		padding: 2rem 0.5rem;
		box-sizing: border-box;
	}

	.title {
		font-size: 2rem;
		line-height: 2.25rem;
		font-family: var(--font-archivo-black);
		font-weight: 400;
		font-style: normal;
	}

	@media(width < 700px) {
		.text {
			padding: 0.5rem 0.5rem 2rem;
		}

		.title {
			font-size: 1.5rem;
			line-height: 1.75rem;
		}
	}

	.category,
	.date,
	.author {
		font-size: 1.25rem;
		line-height: 1.25rem;
		font-family: var(--font-kode-mono);
		font-weight: 400;
		font-style: normal;
	}

	.category {
		text-transform: uppercase;
	}
</style>
