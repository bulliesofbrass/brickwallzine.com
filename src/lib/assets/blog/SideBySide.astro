---
interface Props {
	style?: astroHTML.JSX.HTMLAttributes['style'];
	columns?: number;
	stack?: boolean;
	gap?: string;
}

const {
	style,
	columns = 2,
	stack = true,
	gap = "1rem"
} = Astro.props;
---

<div class:list={["side-by-side", { stack }]} style={style}>
	<slot />
</div>

<style define:vars={{ columns, gap }}>
	.side-by-side {
		display: grid;
		grid-template-columns: repeat(var(--columns), 1fr);
		gap: var(--gap);
	}

	.side-by-side > :global(*) {
		min-width: 0;
	}

	@media (width < 700px) {
		.side-by-side.stack {
			grid-template-columns: 1fr;
		}
	}
</style>
