---
import { Image } from "#lib/elements";
import scarlet from "./scarlet.png";
import kalypso from "./kalypso.png";

interface Props {
	class?: string;
}

const {
	class: className,
	...rest
} = Astro.props;
---

<div id="polaroids" class:list={[className]} {...rest}>
	<a class="polaroid" href="https://www.instagram.com/scarletsomerville/" target="_blank" rel="noopener noreferrer">
		<div class="image">
			<Image src={scarlet} />
		</div>
		<span class="caption scarlet">Scarlet</span>
	</a>

	<a class="polaroid" href="https://www.instagram.com/kalyptt/" target="_blank" rel="noopener noreferrer">
		<div class="image">
			<Image src={kalypso} />
		</div>
		<span class="caption kalypso">Kalypso</span>
	</a>
</div>

<style>
	#polaroids {
		--polaroid-height: 368px;
		--polaroid-width: 300px;

		width: 100%;

		position: absolute;
		top: calc(200svh + var(--polaroid-height) / -2 * 1.5);
		right: 50px;
		z-index: 100;

		display: flex;
		justify-content: end;
		gap: 15px;

		padding: 30px;
		box-sizing: border-box;
	}

	.polaroid {
		height: var(--polaroid-height);
		width: var(--polaroid-width);

		display: flex;
		flex-direction: column;

		padding: 15px;
		box-sizing: border-box;

		background-color: white;

		text-decoration: none;
	}

	.image {
		aspect-ratio: 1/1;
		background: black;
	}

	.image :global(img) {
		animation: develop ease-in both;
		animation-timeline: scroll(root);
		animation-range: 200svh 300svh;
	}

	@keyframes develop {
		from {
			opacity: 0;
		}
	}

	.caption {
		flex: 1;
		display: grid;
		place-items: center;
		color: black;
		font-family: var(--font-babylonica);
		font-size: 64px;
	}

	.caption.scarlet {
		translate: -10px 0px;
	}

	.caption.kalypso {
		translate: -10px;
		font-size: 50px;
	}
</style>
