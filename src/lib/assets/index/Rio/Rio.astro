---
import { Image } from "#lib/elements";
import left from "./left.webp";
import right from "./right.webp";
import wall from "../IMG_0751.webp"
---

<section id="rio">
	<Image class="background" src={wall} style="transform: scaleY(-1);" />

	<div class="twin">
		<a href="" class="left">
			<Image class="left" src={left} />
			<!-- <div class="caption">&nbsp;FASHION&nbsp;</div> -->
		</a>

		<a href="" class="right">
			<Image class="left" src={right} />
			<!-- <div class="caption">&nbsp;Interviews&nbsp;</div> -->
		</a>
	</div>
</section>

<style>
	#rio {
		position: relative;
		height: 100svh;
		width: 100%;
	}

	.background {
		position: absolute;
		z-index: 1;
		object-fit: cover;
	}

	.twin {
		position: relative;
		height: 100%;
		padding: 2rem 0.5rem 0.5rem;
		box-sizing: border-box;
		display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        grid-template-rows: minmax(0, 1fr);
		gap: 0.5rem;
		z-index: 100;
		transition: grid-template-columns 0.3s ease;
	}

	.twin :global(img) {
		transition: filter 0.3s ease;
	}

	.left, .right {
		object-fit: cover;
	}

	/* .twin:has(> .left:hover) {
		grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
	}

	.twin:has(> .right:hover) {
		grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
	}

	.twin:has(> .left:hover) > .right :global(img),
	.twin:has(> .right:hover) > .left :global(img) {
		filter: grayscale(1);
	} */

	.twin > div {
		position: relative;
	}

	.twin .caption {
		position: absolute;
		bottom: 1rem;
		inset-inline: 0;
		margin: 0;
		text-align: center;
		font-family: var(--font-blackout-two-am);
		font-size: 32px;
	}


</style>
