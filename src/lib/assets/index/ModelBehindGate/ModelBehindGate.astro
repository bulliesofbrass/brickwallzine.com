---
import { Image } from "#lib/elements";
import _000042 from "./000042.jpeg";
---

<section>
	<Image class="background" src={_000042} />

	<div class="paintitred">Editors</div>
</section>

<style>
	section {
		position: relative;
		height: 100svh;
		width: 100%;
	}

	.background {
		object-fit: cover;
	}

	.paintitred {
		height: 500px;
		top: calc(100svh - 400px);
		right: 0px;
		position: absolute;
		font-family: var(--font-ballet);
		color: red;
		font-size: 400px;
	}
</style>
